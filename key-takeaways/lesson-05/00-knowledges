Vùng repo -> đưa về working directory
//Huỷ bỏ 1 commit gần nhất, từ vùng repo về working directory
git reset HEAD~1
//Huỷ bỏ 2 commit gần nhất, từ vùng repo về working directory
git reset HEAD~2
//Huỷ bỏ 3 commit gần nhất, từ vùng repo về working directory
